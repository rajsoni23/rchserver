# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/rch_manager?retryWrites=true&w=majority

# JWT Authentication Secret Key (Generate any secure random string)
JWT_SECRET=rch-manager-super-secret-jwt-key-change-this-in-production-2026

# Admin Credentials for Web Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# Optional UPI Payment Default
DEFAULT_UPI_ID=rch.manager@upi

# Local Development Port
PORT=5000
